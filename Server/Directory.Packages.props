<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <ExtensionsVersion>10.0.0</ExtensionsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(ExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup Label="Sources">
    <PackageVersion Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Transitive pins">
    <!--
      Microsoft.Data.SqlClient 7.1.1 brings 9.0.18, which carries GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7.
      10.0.13 carries neither, and it is the least the service's Pluperfect.Mail asks for, as that repository pins.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      EF Core Sqlite 9.0.0 brings SQLitePCLRaw.lib.e_sqlite3 2.1.10 (GHSA-2m69-gcr7-jv3q). The four move together,
      since mixed versions fail at run time. The same pins build green in Scry.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup Label="Destinations">
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
  </ItemGroup>

  <!--
    Pomelo has no EF Core 10 build yet, so EF Core stays on 9. Raising EF alone fails at run time, not at
    build. Move both together once nuget.org lists a Pomelo 10.
  -->
  <PropertyGroup>
    <AspNetCoreVersion>10.0.0</AspNetCoreVersion>
    <EfCoreVersion>9.0.0</EfCoreVersion>
  </PropertyGroup>

  <ItemGroup Label="Service">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NUnit" Version="4.4.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.1.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
