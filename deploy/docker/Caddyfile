# Nexus in Docker over HTTPS: its pages, the service, and the address providers send people back to after signing in.
# Caddy makes each certificate from its own authority, which the launcher asks this computer to trust.
{
	skip_install_trust
	auto_https disable_redirects
	# A browser sends no server name to an IP address, so this picks the certificate.
	default_sni 127.0.0.1
}

https://localhost:6165 {
	tls internal
	root * /srv
	encode gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

https://localhost:6163 {
	tls internal
	reverse_proxy nexus-api:6163
}

https://127.0.0.1:6164 {
	tls internal
	reverse_proxy nexus-api:6163
}
