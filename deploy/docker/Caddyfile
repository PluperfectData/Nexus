# Nexus's pages in Docker, and the HTTPS address providers send people back to after signing in, which goes on to
# the service. Caddy makes that address's certificate itself, so a browser warns about it once.
{
	skip_install_trust
	# A browser sends no server name to an IP address, so this picks the certificate.
	default_sni 127.0.0.1
}

:6165 {
	root * /srv
	encode gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

https://127.0.0.1:6164 {
	tls internal
	reverse_proxy nexus-api:6163
}
